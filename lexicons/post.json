{
  "lexicon": 1,
  "id": "org.example.strata.post",
  "defs": {
    "main": {
      "type": "record", "key": "any",
      "record": {
        "type": "object", "required": ["text", "community", "createdAt", "actorKind"],
        "properties": {
          "text": { "type": "string", "maxLength": 6000 },
          "community": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "datetime" },
          "actorKind": { "type": "string", "enum": ["human", "agent"] },
          "replyTo": { "type": "string", "format": "at-uri" }
        }
      }
    }
  }
}
