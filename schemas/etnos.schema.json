{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etnos.space/schemas/etnos.schema.json",
  "title": "etnos.yaml",
  "description": "One ETNOS deployment: its name, the region it serves, its languages, catalogue, news sources, model provider by name and the Kios house rules. It never holds a key, token or password.",
  "type": "object",
  "required": ["version", "name"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "the deployment's name as people see it" },
    "description": { "type": "string", "maxLength": 300 },
    "origin": { "type": "string", "pattern": "^https?://[^/\\s]+$", "description": "the address of the deployment, set in the Worker settings" },
    "rootPlace": { "type": ["string", "null"], "pattern": "^Q[1-9][0-9]{0,11}$", "description": "a Wikidata item id such as Q3845" },
    "uiLanguage": { "enum": ["id"], "description": "the interface is in Indonesian only today" },
    "regionLanguages": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{4}[0-9]{4}$", "description": "a Glottolog code such as ekar1243" }, "description": "empty means every language in the catalogue" },
    "catalogue": { "type": "string", "pattern": "^[a-z0-9-]{1,60}$" },
    "enrollment": { "enum": ["open", "invite", "closed"] },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": { "type": "array", "maxItems": 40, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^/\\s]+$", "description": "a source origin such as https://papua.antaranews.com" } }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "maxLength": 120, "description": "workers-ai, or the host of the provider that holds the key" },
        "fast": { "type": ["string", "null"], "maxLength": 200 },
        "synthesis": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200, "pattern": "^$|^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$", "description": "an email address" },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^$|^https://", "description": "a complete https address" },
        "did": { "type": "string", "maxLength": 200 }
      }
    },
    "signup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumAge": { "type": "integer", "minimum": 13, "maximum": 99, "description": "the age a new person confirms when joining; 18 when left out" }
      }
    },
    "kios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["key", "label", "words"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "words": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?:[a-z0-9-]+|\\([a-z0-9-]+(?:\\|[a-z0-9-]+)+\\))(?: (?:[a-z0-9-]+|\\([a-z0-9-]+(?:\\|[a-z0-9-]+)+\\)))*$", "description": "lowercase words; (a|b) offers a choice, for example (jual|sewa) tanah" } }
            }
          }
        }
      }
    }
  }
}
