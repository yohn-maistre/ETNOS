{
  "name": "@abstraksi/etnos",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:ui": "npm run check --prefix apps/web",
    "build:ui": "npm run build --prefix apps/web",
    "test:ui": "npm test --prefix apps/web",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "demo": "node --disable-warning=ExperimentalWarning src/cli.ts demo",
    "check:worker": "tsc -p tsconfig.worker.json",
    "types:worker": "wrangler types worker-configuration.d.ts --config wrangler.web.jsonc --include-runtime false --strict-vars false",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "test:worker": "wrangler deploy --dry-run --config wrangler.test.jsonc --outdir .wrangler/test && node --test test/worker.test.mjs",
    "dev:worker": "wrangler dev --var ETNOS_ORIGIN:http://localhost:8787",
    "pds": "node --disable-warning=ExperimentalWarning src/pds-cli.ts",
    "test:web": "wrangler deploy --dry-run --config wrangler.web-test.jsonc --outdir .wrangler/web-test && node --test test/web-origin.test.mjs",
    "demo:steward": "node --disable-warning=ExperimentalWarning scripts/simulate-steward.ts"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "0.3.11",
    "@atproto/api": "0.30.0",
    "@atproto/lexicon": "0.7.17",
    "@atproto/oauth-client-node": "0.5.13",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.15",
    "saxes": "6.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261023.3-beta",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
