{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strata-preview",
  "main": "src/web-worker.ts",
  "minify": true,
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "STRATA_ORIGIN": "https://etnos.space",
    "STRATA_NODE": "preview",
    "STRATA_AUTH_MODE": "atproto",
    "STRATA_ENROLLMENT_MODE": "open",
    "STRATA_CLIENT_NAME": "ETNOS",
    "STRATA_STEWARD_DID": "did:plc:uhhrncfqtpg26h24irfcpuma",
    "STRATA_COLLECTION": "org.example.strata.post",
    "STRATA_PUBLISHING_ENABLED": "false",
    "STRATA_OAUTH_HOSTS": "bsky.social,public.api.bsky.app,plc.directory,.host.bsky.network",
    "STRATA_DECISIONS_ENABLED": "true",
    "STRATA_RESIDENT_RESEARCH": "on",
    "STRATA_CATALOGUE": "tanah-papua",
    "ETNOS_SITUS_SUBDOMAINS": "on",
    "STRATA_SOURCE_ORIGINS": "https://papua.antaranews.com,https://www.antaranews.com,https://westpapua.watch"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STRATA",
        "class_name": "StrataNode"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StrataNode"
      ]
    }
  ],
  // Our own log line per request carries only the route shape and row counts.
  // Invocation logs stay off: they would record full URLs, including search text.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "STRATA_OAUTH_JWK",
      "STRATA_AUTH_SEAL_KEY"
    ]
  },
  "services": [
    {
      "binding": "RESIDENT_PI",
      "service": "strata-resident-pi",
      "entrypoint": "ResidentRuntime"
    },
    {
      "binding": "WATCH_NEWS",
      "service": "westpapua-watch-engine"
    }
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // Static files are served without running the Worker, so they do not count
    // against the 100,000 requests a day on Workers Free. Pages still run it.
    "run_worker_first": ["/*", "!/assets/*", "!/branding/*", "!/fonts/*", "!/img/*", "!/textures/*", "!/observatory/*", "!/share/*", "!/third-party-notices.txt", "!/manifest.webmanifest", "!/sw.js"],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}
