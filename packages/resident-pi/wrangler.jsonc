{
 "$schema":"../../node_modules/wrangler/config-schema.json",
 "name":"strata-resident-pi",
 "main":"src/worker.ts",
 "compatibility_date":"2026-10-23",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,
 "preview_urls":false,
 "durable_objects":{"bindings":[{"name":"SESSIONS","class_name":"PiResidentSession"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["PiResidentSession"]}],
 "services":[
  {"binding":"AUTHORITY","service":"strata-preview","entrypoint":"ResidentAuthority"},
  {"binding":"MODEL_GATEWAY","service":"westpapua-watch-engine","entrypoint":"CommonsIntelligence"}
 ],
 // Optional. Enables the Agents SDK web_search (Cloudflare Web Search API, billed
 // through the account's AI Gateway) and web_fetch (Workers AI Markdown
 // conversion) tools for thread replies only. Without this binding the runtime
 // offers no web tools. Requires AI Gateway credits or a provider key.
 "ai":{"binding":"AI"},
 // Turn on only after the model gateway accepts search_reviewed_wiki, web_search and web_fetch.
 "vars":{"RESIDENT_RESEARCH_TOOLS":"off"},
 "observability":{"enabled":false}
}
